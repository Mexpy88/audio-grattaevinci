  captureStockFilters(){return{query:document.getElementById('stockQuery')?.value||'',state:document.getElementById('stockState')?.value||'',location:document.getElementById('stockLocation')?.value||'',pallet:document.getElementById('stockPallet')?.value||'',scrollY:globalThis.scrollY||0}}
  openRectify(key=''){if(!this.require('RECTIFY',{master:true}))return;const from=this.router.route.name,selected=key?this.domain.stock.findByKey(key):null;this.rectifyContext={from,filters:from==='stock'?this.captureStockFilters():null};this.rectifyDraft={selectedKey:selected?bucketKey(selected):'',partials:[],counted:selected?.quantity??0};this.router.go('rectify',{key:selected?bucketKey(selected):''})}
  rectify(key=''){if(!this.require('RECTIFY',{master:true}))return'';if(!this.rectifyDraft){const r=key?this.domain.stock.findByKey(key):null;this.rectifyDraft={selectedKey:r?bucketKey(r):'',partials:[],counted:r?.quantity??0}}const selected=this.rectifyDraft.selectedKey?this.domain.stock.findByKey(this.rectifyDraft.selectedKey):null;const values=selected||{};setTimeout(()=>this.renderRectifyResults(),0);return `${this.sectionTitle('GIACENZE','Rettifica','Ricerca la giacenza esatta, conta con parziali e registra la correzione in modo tracciato.')}<div class="rectify-shell"><section class="form-card rectify-search-card"><div class="rectify-title-chip">✦ RETTIFICA INVENTARIALE</div><div class="rectify-grid"><label>Articolo<input id="rectArticle" class="field stock-query-uppercase" value="${esc(values.article||'')}" placeholder="CODICE ARTICOLO" autocapitalize="characters" autocomplete="off" spellcheck="false" oninput="this.value=this.value.toUpperCase()"></label><label>Taglia<input id="rectSize" class="field" value="${esc(values.size||'')}" placeholder="TUTTE LE TAGLIE" autocapitalize="characters" autocomplete="off"></label><label>Fila / Scaffale<input id="rectLocation" class="field" value="${esc(values.location||'')}" placeholder="FACOLTATIVO" autocomplete="off"></label><label>Bancale<input id="rectPallet" class="field" value="${esc(values.pallet||'')}" placeholder="FACOLTATIVO" autocomplete="off"></label></div><label>Stato<select id="rectState" class="field"><option value="">TUTTI GLI STATI</option>${CONFIG.states.map(s=>`<option ${values.state===s?'selected':''}>${s}</option>`).join('')}</select></label><input id="rectKey" type="hidden" value="${esc(this.rectifyDraft.selectedKey||'')}"><div id="rectifyResults" class="rectify-results"></div></section><div id="rectifySelected">${selected?this.rectifySelectedMarkup(selected):'<div class="empty compact">Seleziona una giacenza dalla lista per iniziare la rettifica.</div>'}</div></div>`}
  rectifySelectedMarkup(r){const partials=this.rectifyDraft?.partials||[],counted=Number(this.rectifyDraft?.counted??r.quantity),diff=counted-r.quantity,diffClass=diff<0?'negative':diff>0?'positive':'zero',sign=diff>0?'+':'';return `<section class="form-card rectify-search-card"><div class="rectify-selected"><div class="rectify-selected-head"><div><span class="rectify-title-chip">STAI RETTIFICANDO</span><b>${esc(r.article)}${r.size?` · ${esc(r.size)}`:''}</b></div><strong>${r.quantity}</strong></div><div class="rectify-selected-meta"><span>${esc(r.state)}</span><span>Fila/Scaffale ${esc(r.location||'—')}</span><span>Bancale ${esc(r.pallet||'—')}</span></div></div><div class="rectify-count-box"><b>CONTEGGIO PARZIALE</b><div class="rectify-partial-row"><label>Quantità parziale<input id="rectPartial" type="number" min="1" class="field" placeholder="Es. 100"></label><button class="primary" data-action="rect-partial-add">＋ AGGIUNGI</button></div><div class="rectify-chips">${partials.map((x,i)=>`<button type="button" data-action="rect-partial-remove" data-index="${i}" aria-label="Rimuovi parziale ${x}">${x}</button>`).join('')}</div>${partials.length?`<div class="mini-actions"><button class="soft small" data-action="rect-partial-undo">ANNULLA ULTIMO</button><button class="soft small" data-action="rect-partial-clear">AZZERA PARZIALI</button></div>`:''}<label>Quantità conteggiata<input id="rectCounted" type="number" min="0" class="field" value="${counted}"></label><div class="rectify-total"><div><span>QUANTITÀ SISTEMA</span><b>${r.quantity}</b></div><div><span>QUANTITÀ CONTATA</span><b id="rectMetricCounted">${counted}</b></div><div class="diff ${diffClass}" id="rectMetricDiff"><span>DIFFERENZA</span><b>${sign}${diff}</b></div></div></div><label>Nota opzionale<input id="rectNote" class="field" placeholder="Motivo o annotazione reale"></label><div class="workflow-actions"><button class="workflow-cancel" data-action="workflow-back">ANNULLA</button><button class="primary rectify-save" data-action="rectify-save">SALVA RETTIFICA</button></div></section>`}
  renderRectifySelected(){const host=document.getElementById('rectifySelected');if(!host)return;const r=this.rectifyDraft?.selectedKey?this.domain.stock.findByKey(this.rectifyDraft.selectedKey):null;host.innerHTML=r?this.rectifySelectedMarkup(r):'<div class="empty compact">Seleziona una giacenza dalla lista per iniziare la rettifica.</div>'}
  rectifyFilters(){return{article:normalizeArticle(document.getElementById('rectArticle')?.value),size:norm(document.getElementById('rectSize')?.value),state:norm(document.getElementById('rectState')?.value),location:positionKey(document.getElementById('rectLocation')?.value),pallet:positionKey(document.getElementById('rectPallet')?.value)}}
  renderRectifyResults(){const host=document.getElementById('rectifyResults');if(!host)return;const f=this.rectifyFilters(),active=!!(f.article||f.size||f.state||f.location||f.pallet);const current=this.rectifyDraft?.selectedKey?this.domain.stock.findByKey(this.rectifyDraft.selectedKey):null;if(current){const stillMatches=(!f.article||normalizeArticle(current.article).includes(f.article))&&(!f.size||norm(current.size)===f.size)&&(!f.state||norm(current.state)===f.state)&&positionMatches(current,f.location,f.pallet);if(!stillMatches){this.rectifyDraft.selectedKey='';this.rectifyDraft.partials=[];this.rectifyDraft.counted=0;const key=document.getElementById('rectKey');if(key)key.value='';this.renderRectifySelected()}}if(!active){host.innerHTML='<div class="empty compact">Scrivi Articolo, Taglia, Fila/Scaffale o Bancale: la lista si aggiorna mentre digiti.</div>';return}const rows=this.domain.stock.positive().filter(r=>(!f.article||normalizeArticle(r.article).includes(f.article))&&(!f.size||norm(r.size)===f.size)&&(!f.state||norm(r.state)===f.state)&&positionMatches(r,f.location,f.pallet)).slice(0,80);host.innerHTML=rows.length?rows.map(r=>`<button type="button" class="rectify-result" data-action="rectify-pick" data-key="${esc(bucketKey(r))}"><span><b>${esc(r.article)}${r.size?` · ${esc(r.size)}`:''}</b><small>${esc(r.state)} · Fila/Scaffale ${esc(r.location||'—')} · Bancale ${esc(r.pallet||'—')}</small></span><strong>${r.quantity}</strong></button>`).join(''):'<div class="empty compact">Nessuna giacenza corrisponde ai filtri inseriti.</div>'}
  rectPick(key){const r=this.domain.stock.findByKey(key);if(!r)throw new Error('Giacenza non disponibile.');this.rectifyDraft={selectedKey:bucketKey(r),partials:[],counted:r.quantity};const set=(id,v)=>{const e=document.getElementById(id);if(e)e.value=v??''};set('rectArticle',r.article);set('rectSize',r.size);set('rectState',r.state);set('rectLocation',r.location);set('rectPallet',r.pallet);set('rectKey',bucketKey(r));this.renderRectifySelected();this.renderRectifyResults()}
  rectDirect(value){if(!this.rectifyDraft)return;this.rectifyDraft.partials=[];this.rectifyDraft.counted=Math.max(0,integer(value));this.updateRectMetrics()}
  updateRectMetrics(){const r=this.rectifyDraft?.selectedKey?this.domain.stock.findByKey(this.rectifyDraft.selectedKey):null;if(!r)return;const counted=Math.max(0,integer(document.getElementById('rectCounted')?.value??this.rectifyDraft.counted)),diff=counted-r.quantity,c=document.getElementById('rectMetricCounted'),d=document.getElementById('rectMetricDiff');this.rectifyDraft.counted=counted;if(c)c.textContent=String(counted);if(d){d.className=`diff ${diff<0?'negative':diff>0?'positive':'zero'}`;d.innerHTML=`<span>DIFFERENZA</span><b>${diff>0?'+':''}${diff}</b>`}}
  addRectPartial(){if(!this.rectifyDraft?.selectedKey)throw new Error('Seleziona prima una giacenza.');const input=document.getElementById('rectPartial'),v=integer(input?.value);if(v<=0)throw new Error('Inserisci una quantità parziale maggiore di zero.');this.rectifyDraft.partials.push(v);this.rectifyDraft.counted=this.rectifyDraft.partials.reduce((n,x)=>n+x,0);this.renderRectifySelected()}
  removeRectPartial(index){if(!this.rectifyDraft)return;this.rectifyDraft.partials.splice(Number(index),1);this.rectifyDraft.counted=this.rectifyDraft.partials.reduce((n,x)=>n+x,0);this.renderRectifySelected()}
  undoRectPartial(){if(!this.rectifyDraft)return;this.rectifyDraft.partials.pop();this.rectifyDraft.counted=this.rectifyDraft.partials.reduce((n,x)=>n+x,0);this.renderRectifySelected()}
  clearRectPartials(){if(!this.rectifyDraft)return;this.rectifyDraft.partials=[];const r=this.rectifyDraft.selectedKey?this.domain.stock.findByKey(this.rectifyDraft.selectedKey):null;this.rectifyDraft.counted=r?.quantity??0;this.renderRectifySelected()}
  saveRectify(){const key=this.rectifyDraft?.selectedKey||document.getElementById('rectKey')?.value;if(!key)throw new Error('Seleziona la giacenza esatta da rettificare.');const counted=Math.max(0,integer(document.getElementById('rectCounted')?.value??this.rectifyDraft.counted)),partials=[...(this.rectifyDraft?.partials||[])],note=document.getElementById('rectNote')?.value||'';this.domain.rectifications.setQuantity({currentKey:key,counted,note,partials,method:'RECTIFICATION_MANUAL'});const context=this.rectifyContext;this.rectifyDraft=null;this.rectifyContext=null;this.toast(`Rettifica registrata · ${counted} pezzi.`);if(context?.from==='stock'){this.router.back();const f=context.filters||{},set=(id,v)=>{const e=document.getElementById(id);if(e)e.value=v||''};set('stockQuery',f.query);set('stockState',f.state);set('stockLocation',f.location);set('stockPallet',f.pallet);this.renderStockResults();setTimeout(()=>globalThis.scrollTo?.({top:Number(f.scrollY)||0,behavior:'instant'}),0)}else this.router.replace('rectify',{key:''})}

  restoreCountDraft(){if(!this.countDraft&&this.store.db.settings?.countDraft)this.countDraft=clone(this.store.db.settings.countDraft);return this.countDraft}
  persistCountDraft(){this.store.db.settings.countDraft=this.countDraft?clone(this.countDraft):null;this.store.save('count:draft')}
  count(){if(!this.require('COUNT',{master:true}))return'';this.restoreCountDraft();setTimeout(()=>this.renderCountBody(),0);return `${this.sectionTitle('GIACENZE','Conteggio assistito','Conferma ogni singola giacenza; al termine concludi l’intera sessione di inventario.')}<section class="form-card count-position-card"><div class="position-filter-block"><div class="position-filter-head"><span><b>POSIZIONE DA CONTARE</b><small>Compila Fila/Scaffale, Bancale oppure entrambi.</small></span><span class="exact-chip">MATCH ESATTO</span></div><div class="position-filter-grid"><label>Fila / Scaffale<input id="countLocation" class="field" value="${esc(this.countDraft?.location||'')}" placeholder="Facoltativo"></label><label>Bancale<input id="countPallet" class="field" value="${esc(this.countDraft?.pallet||'')}" placeholder="Facoltativo"></label></div><div class="position-filter-help">Errore solo se entrambi i campi sono vuoti.</div></div><button class="primary" data-action="count-load">${this.countDraft?'RICARICA POSIZIONE':'CARICA POSIZIONE'}</button></section><div id="countBody"></div>`}
  loadCount(){const location=positionKey(document.getElementById('countLocation')?.value),pallet=positionKey(document.getElementById('countPallet')?.value);if(!location&&!pallet)throw new Error('Inserisci almeno Fila/Scaffale oppure Bancale.');if(this.countDraft&&!confirm('Ricaricare la posizione? Il conteggio in corso per questa sessione verrà sostituito.'))return;const rows=this.domain.stock.positive().filter(r=>positionMatches(r,location,pallet));this.countDraft={id:uid(),startedAt:nowIso(),location,pallet,rows:rows.map((r,i)=>({domId:`c${i}-${uid().slice(0,5)}`,key:bucketKey(r),source:r,partials:[],counted:null,verified:false,confirmed:false,confirmedAt:'',reopenedAt:'',editCount:0})),extras:[]};this.persistCountDraft();this.renderCountBody()}
  countRowMarkup(r){const total=Number(r.counted??r.partials.reduce((n,x)=>n+x,0)),diff=total-r.source.quantity;if(r.confirmed)return `<article class="count-card completed"><button type="button" class="count-edit" data-action="count-edit" data-dom="${r.domId}" aria-label="Modifica conteggio">✎</button><span class="count-done-mark">✓</span><div class="count-locked-content"><b>${esc(r.source.article)}${r.source.size?` · ${esc(r.source.size)}`:''}</b><span class="count-position-meta">${esc(r.source.state)} · Fila/Scaffale ${esc(r.source.location||'—')} · Bancale ${esc(r.source.pallet||'—')}</span><span class="count-status-label">CONTEGGIATO</span><div class="rectify-total"><div><span>SISTEMA</span><b>${r.source.quantity}</b></div><div><span>CONTATI</span><b>${total}</b></div><div><span>DIFFERENZA</span><b class="count-diff ${diff<0?'negative':diff>0?'positive':''}">${diff>0?'+':''}${diff}</b></div></div>${r.partials.length?`<div class="chips">${r.partials.map(x=>`<span>${x}</span>`).join('')}</div>`:''}</div></article>`;return `<article class="count-card"><div><b>${esc(r.source.article)}${r.source.size?` · ${esc(r.source.size)}`:''}</b><span class="count-position-meta">Atteso: <strong>${r.source.quantity}</strong> · ${esc(r.source.state)} · Fila/Scaffale ${esc(r.source.location||'—')} · Bancale ${esc(r.source.pallet||'—')}</span></div><div class="partial-input"><input id="count-${r.domId}" type="number" min="1" class="field" placeholder="Parziale"><button class="primary small" data-action="count-partial-add" data-dom="${r.domId}">AGGIUNGI</button></div><div class="chips">${r.partials.map((x,i)=>`<button type="button" data-action="count-partial-remove" data-dom="${r.domId}" data-index="${i}">${x} ×</button>`).join('')}<small>Contati: <b>${total}</b>${r.verified?' · pronto da confermare':''}</small></div><div class="mini-actions"><button class="soft small" data-action="count-zero" data-dom="${r.domId}">NON PRESENTE</button>${r.partials.length?`<button class="soft small" data-action="count-undo" data-dom="${r.domId}">ANNULLA ULTIMO</button><button class="soft small" data-action="count-clear" data-dom="${r.domId}">AZZERA</button>`:''}</div><button class="success count-confirm-line" data-action="count-confirm" data-dom="${r.domId}" ${r.verified?'':'disabled'}>✓ CONFERMA ARTICOLO</button></article>`}
  countExtraMarkup(r,i){const total=Number(r.counted||0);if(r.confirmed)return `<article class="count-card count-extra completed"><button type="button" class="count-edit" data-action="count-extra-edit" data-dom="${r.domId}" aria-label="Modifica materiale trovato">✎</button><span class="count-done-mark">✓</span><div class="count-locked-content"><b>${esc(r.article)}${r.size?` · ${esc(r.size)}`:''}</b><span class="count-position-meta">${esc(r.state)} · Fila/Scaffale ${esc(r.location||'—')} · Bancale ${esc(r.pallet||'—')}</span><span class="count-status-label">CONTEGGIATO</span><div class="rectify-total"><div><span>CONTATI</span><b>${total}</b></div></div></div></article>`;return `<article class="count-card count-extra"><div class="line-top"><b>MATERIALE TROVATO ${i+1}</b><button data-action="count-extra-remove" data-dom="${r.domId}">RIMUOVI</button></div><label>Codice articolo<input class="field stock-query-uppercase" data-count-extra="article" data-dom="${r.domId}" value="${esc(r.article)}" autocapitalize="characters" oninput="this.value=this.value.toUpperCase()"></label><div class="two"><label>Taglia<input class="field" data-count-extra="size" data-dom="${r.domId}" value="${esc(r.size)}"></label><label>Stato<select class="field" data-count-extra="state" data-dom="${r.domId}">${CONFIG.states.map(x=>`<option ${r.state===x?'selected':''}>${x}</option>`).join('')}</select></label></div><div class="two"><label>Fila/Scaffale<input class="field" data-count-extra="location" data-dom="${r.domId}" value="${esc(r.location||this.countDraft.location)}"></label><label>Bancale<input class="field" data-count-extra="pallet" data-dom="${r.domId}" value="${esc(r.pallet||this.countDraft.pallet)}"></label></div><div class="partial-input"><input id="count-extra-${r.domId}" type="number" min="1" class="field" placeholder="Parziale"><button class="primary small" data-action="count-extra-partial-add" data-dom="${r.domId}">AGGIUNGI</button></div><div class="chips">${r.partials.map(x=>`<span>${x}</span>`).join('')}<small>Contati: <b>${total}</b></small></div>${r.partials.length?`<div class="mini-actions"><button class="soft small" data-action="count-extra-undo" data-dom="${r.domId}">ANNULLA ULTIMO</button><button class="soft small" data-action="count-extra-clear" data-dom="${r.domId}">AZZERA</button></div>`:''}<button class="success count-confirm-line" data-action="count-extra-confirm" data-dom="${r.domId}" ${(r.article&&total>0&&(r.location||r.pallet))?'':'disabled'}>✓ CONFERMA ARTICOLO</button></article>`}
  renderCountBody(){const host=document.getElementById('countBody');if(!host||!this.countDraft)return;const totalRows=this.countDraft.rows.length+(this.countDraft.extras||[]).length,done=this.countDraft.rows.filter(r=>r.confirmed).length+(this.countDraft.extras||[]).filter(r=>r.confirmed).length,pct=totalRows?Math.round(done/totalRows*100):0,expected=this.countDraft.rows.map(r=>this.countRowMarkup(r)).join(''),extras=(this.countDraft.extras||[]).map((r,i)=>this.countExtraMarkup(r,i)).join(''),scope=[this.countDraft.location?`Fila/Scaffale ${this.countDraft.location}`:'',this.countDraft.pallet?`Bancale ${this.countDraft.pallet}`:''].filter(Boolean).join(' · '),allDone=totalRows>0&&done===totalRows;host.innerHTML=`<div class="count-scope"><span><span>AREA DI CONTEGGIO</span><b>${esc(scope)}</b></span><i>=</i></div><div class="count-progress"><div class="count-progress-head"><b>AVANZAMENTO SESSIONE</b><strong>${done} / ${totalRows}</strong></div><div class="count-progress-track"><i style="width:${pct}%"></i></div></div>${expected||'<div class="empty compact">Nessun articolo previsto con questi filtri esatti.</div>'}<section class="count-extra-section"><div class="section-label">MATERIALE NON PREVISTO</div>${extras}<button class="add-btn" data-action="count-extra-add">＋ MATERIALE TROVATO NON PREVISTO</button></section><div class="workflow-actions"><button class="workflow-cancel" data-action="workflow-back">ESCI</button><button class="success count-finalize" data-action="count-finalize" ${allDone?'':'disabled'}>✓ CONCLUDI CONTEGGIO</button></div>`}
  addCountPartial(domId){const r=this.countDraft?.rows.find(x=>x.domId===domId);if(!r||r.confirmed)return;const input=document.getElementById(`count-${domId}`),v=integer(input?.value);if(v>0){r.partials.push(v);r.counted=r.partials.reduce((n,x)=>n+x,0);r.verified=true;this.persistCountDraft()}this.renderCountBody()}
  removeCountPartial(domId,index){const r=this.countDraft?.rows.find(x=>x.domId===domId);if(!r||r.confirmed)return;r.partials.splice(Number(index),1);r.counted=r.partials.reduce((n,x)=>n+x,0);r.verified=r.partials.length>0;this.persistCountDraft();this.renderCountBody()}
  undoCountPartial(domId){const r=this.countDraft?.rows.find(x=>x.domId===domId);if(!r||r.confirmed)return;r.partials.pop();r.counted=r.partials.reduce((n,x)=>n+x,0);r.verified=r.partials.length>0;this.persistCountDraft();this.renderCountBody()}
  clearCountPartial(domId){const r=this.countDraft?.rows.find(x=>x.domId===domId);if(!r||r.confirmed)return;r.partials=[];r.counted=null;r.verified=false;this.persistCountDraft();this.renderCountBody()}
  countZero(domId){const r=this.countDraft?.rows.find(x=>x.domId===domId);if(!r||r.confirmed)return;r.partials=[];r.counted=0;r.verified=true;this.persistCountDraft();this.renderCountBody()}
  confirmCountRow(domId){const r=this.countDraft?.rows.find(x=>x.domId===domId);if(!r||r.confirmed)return;if(!r.verified)throw new Error('Conta o materiale oppure indica NON PRESENTE prima di confermare.');r.confirmed=true;r.confirmedAt=nowIso();this.domain.audit.record('COUNT_LINE_CONFIRMED','STOCK',r.key,null,{counted:r.counted,partials:r.partials,sessionId:this.countDraft.id},{sessionId:this.countDraft.id});this.persistCountDraft();this.renderCountBody()}
  editCountRow(domId){const r=this.countDraft?.rows.find(x=>x.domId===domId);if(!r||!r.confirmed)return;r.confirmed=false;r.reopenedAt=nowIso();r.editCount=Number(r.editCount||0)+1;this.domain.audit.record('COUNT_LINE_REOPENED','STOCK',r.key,null,{sessionId:this.countDraft.id,editCount:r.editCount});this.persistCountDraft();this.renderCountBody()}
  addCountExtra(){this.countDraft.extras.push({domId:uid(),article:'',size:'',state:'NUOVO',location:this.countDraft.location||'',pallet:this.countDraft.pallet||'',partials:[],counted:0,confirmed:false,confirmedAt:'',reopenedAt:'',editCount:0});this.persistCountDraft();this.renderCountBody()}
  updateCountExtra(domId,key,value){const r=this.countDraft?.extras.find(x=>x.domId===domId);if(!r||r.confirmed)return;if(key==='article')r.article=normalizeArticle(value);else if(['size','state','location','pallet'].includes(key))r[key]=norm(value);else r[key]=value;this.persistCountDraft()}
  addCountExtraPartial(domId){const r=this.countDraft?.extras.find(x=>x.domId===domId);if(!r||r.confirmed)return;const input=document.getElementById(`count-extra-${domId}`),v=integer(input?.value);if(v>0){r.partials.push(v);r.counted=r.partials.reduce((n,x)=>n+x,0);this.persistCountDraft()}this.renderCountBody()}
  undoCountExtra(domId){const r=this.countDraft?.extras.find(x=>x.domId===domId);if(!r||r.confirmed)return;r.partials.pop();r.counted=r.partials.reduce((n,x)=>n+x,0);this.persistCountDraft();this.renderCountBody()}
  clearCountExtra(domId){const r=this.countDraft?.extras.find(x=>x.domId===domId);if(!r||r.confirmed)return;r.partials=[];r.counted=0;this.persistCountDraft();this.renderCountBody()}
  removeCountExtra(domId){const r=this.countDraft?.extras.find(x=>x.domId===domId);if(r?.confirmed)throw new Error('Riapri prima l’articolo confermato.');this.countDraft.extras=this.countDraft.extras.filter(x=>x.domId!==domId);this.persistCountDraft();this.renderCountBody()}
  confirmCountExtra(domId){const r=this.countDraft?.extras.find(x=>x.domId===domId);if(!r||r.confirmed)return;if(!r.article)throw new Error('Inserisci il codice articolo.');if(Number(r.counted)<=0)throw new Error('Inserisci almeno una quantità contata.');if(!r.location&&!r.pallet)throw new Error('Indica almeno Fila/Scaffale oppure Bancale.');r.confirmed=true;r.confirmedAt=nowIso();this.domain.audit.record('COUNT_EXTRA_CONFIRMED','STOCK',r.article,null,{counted:r.counted,partials:r.partials,sessionId:this.countDraft.id});this.persistCountDraft();this.renderCountBody()}
  editCountExtra(domId){const r=this.countDraft?.extras.find(x=>x.domId===domId);if(!r||!r.confirmed)return;r.confirmed=false;r.reopenedAt=nowIso();r.editCount=Number(r.editCount||0)+1;this.domain.audit.record('COUNT_EXTRA_REOPENED','STOCK',r.article,null,{sessionId:this.countDraft.id,editCount:r.editCount});this.persistCountDraft();this.renderCountBody()}
  finalizeCount(){if(!this.countDraft)throw new Error('Nessun conteggio in corso.');const missing=this.countDraft.rows.filter(r=>!r.confirmed),extraMissing=(this.countDraft.extras||[]).filter(r=>!r.confirmed);if(missing.length||extraMissing.length)throw new Error(`Restano ${missing.length+extraMissing.length} articoli da confermare.`);const scope=[this.countDraft.location?`Fila/Scaffale ${this.countDraft.location}`:'',this.countDraft.pallet?`Bancale ${this.countDraft.pallet}`:''].filter(Boolean).join(' · ');for(const r of this.countDraft.rows)this.domain.rectifications.setQuantity({currentKey:r.key,counted:r.counted,note:`Conteggio assistito · ${scope}`,partials:r.partials,method:'ASSISTED_COUNT'});for(const r of this.countDraft.extras){const location=positionKey(r.location||this.countDraft.location),pallet=positionKey(r.pallet||this.countDraft.pallet),match=this.domain.stock.positive().find(x=>normalizeArticle(x.article)===normalizeArticle(r.article)&&norm(x.size)===norm(r.size)&&norm(x.state)===norm(r.state)&&positionMatches(x,location,pallet));this.domain.rectifications.setQuantity({currentKey:match?bucketKey(match):'',article:r.article,size:r.size,state:r.state,location,pallet,counted:r.counted,note:`Materiale trovato durante conteggio assistito · ${scope}`,partials:r.partials,method:'ASSISTED_COUNT'})}this.domain.audit.record('COUNT_SESSION_COMPLETED','COUNT_SESSION',this.countDraft.id,null,{location:this.countDraft.location,pallet:this.countDraft.pallet,lines:this.countDraft.rows.length,extras:this.countDraft.extras.length,startedAt:this.countDraft.startedAt,completedAt:nowIso()});this.countDraft=null;this.store.db.settings.countDraft=null;this.store.save('count:completed');this.toast('Conteggio concluso e consolidato.');this.router.go('stock')}
