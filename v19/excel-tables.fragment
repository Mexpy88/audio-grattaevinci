function v19XmlEscape(value){return String(value??'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&apos;')}
function v19ColName(index){let n=index+1,out='';while(n){n--;out=String.fromCharCode(65+n%26)+out;n=Math.floor(n/26)}return out}
function v19CellValue(ws,r,c){const cell=ws[X().utils.encode_cell({r,c})];if(!cell||cell.v==null)return'';return String(cell.w??cell.v).trim()}
function v19LastDataRow(ws,headerRow,lastCol){const ref=X().utils.decode_range(ws['!ref']||`A${headerRow}`),start=headerRow-1;for(let r=ref.e.r;r>=start;r--){for(let c=0;c<=lastCol;c++)if(v19CellValue(ws,r,c)!=='')return r+1}return headerRow}
async function enhanceWorkbookTables(bytes,{masterSheet='',masterHeaderRow=1,registryOnly=false}={}){
  const JSZip=await ensureJsZip(),zip=await JSZip.loadAsync(bytes),book=X().read(bytes,{type:'array',cellDates:true,cellStyles:true}),specs=registryOnly
    ?[{sheet:'MOVIMENTI',headerRow:1,key:'MOVIMENTI'},{sheet:'AUDIT',headerRow:1,key:'AUDIT'}]
    :[
      {sheet:masterSheet||'MAGAZZINO',headerRow:Math.max(1,Number(masterHeaderRow)||1),key:'MAGAZZINO',name:'Tabella1'},
      {sheet:'CERCA_GIACENZE',headerRow:14,key:'CERCA_GIACENZE',name:'TabellaCercaGiacenze'},
      {sheet:'REGISTRO_MOVIMENTI',headerRow:1,key:'REGISTRO_MOVIMENTI',name:'TabellaRegistroMovimenti'},
      {sheet:'SCARICHI',headerRow:1,key:'SCARICHI',name:'TabellaScarichi'},
      {sheet:'RICHIESTE',headerRow:1,key:'RICHIESTE',name:'TabellaRichieste'},
      {sheet:'ENTRATE_MERCI',headerRow:1,key:'ENTRATE_MERCI',name:'TabellaEntrateMerci'},
      {sheet:'AUDIT',headerRow:1,key:'AUDIT',name:'TabellaAudit'}
    ];
  for(const path of Object.keys(zip.files).filter(n=>/^xl\/tables\/table\d+\.xml$/.test(n)))zip.remove(path);
  let content=await zip.file('[Content_Types].xml').async('string');content=content.replace(/<Override\b[^>]*PartName="\/xl\/tables\/table\d+\.xml"[^>]*\/>/g,'');
  for(const path of Object.keys(zip.files).filter(n=>/^xl\/worksheets\/sheet\d+\.xml$/.test(n))){let xml=await zip.file(path).async('string');xml=xml.replace(/<tableParts\b[^>]*>[\s\S]*?<\/tableParts>/g,'').replace(/<tableParts\b[^>]*\/>/g,'');zip.file(path,xml)}
  for(const path of Object.keys(zip.files).filter(n=>/^xl\/worksheets\/_rels\/sheet\d+\.xml\.rels$/.test(n))){let xml=await zip.file(path).async('string');xml=xml.replace(/<Relationship\b(?=[^>]*Type="[^"]*\/table")[^>]*\/>/g,'');zip.file(path,xml)}
  let tableId=0;
  for(const spec of specs){const ws=book.Sheets[spec.sheet],sheetIndex=book.SheetNames.indexOf(spec.sheet);if(!ws||sheetIndex<0)continue;const ref=X().utils.decode_range(ws['!ref']||`A${spec.headerRow}`),headerIndex=spec.headerRow-1;let lastCol=-1;for(let c=0;c<=ref.e.c;c++)if(v19CellValue(ws,headerIndex,c)!=='')lastCol=c;if(lastCol<0)continue;const headers=[];for(let c=0;c<=lastCol;c++)headers.push(v19CellValue(ws,headerIndex,c)||`COLONNA ${c+1}`);const lastRow=Math.max(spec.headerRow,v19LastDataRow(ws,spec.headerRow,lastCol)),tableRef=`A${spec.headerRow}:${v19ColName(lastCol)}${lastRow}`,sheetNo=sheetIndex+1,sheetPath=`xl/worksheets/sheet${sheetNo}.xml`,relPath=`xl/worksheets/_rels/sheet${sheetNo}.xml.rels`;let sheetXml=await zip.file(sheetPath).async('string');if(!/\bxmlns:r=/.test(sheetXml))sheetXml=sheetXml.replace(/<worksheet\b/,'<worksheet xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships"');sheetXml=sheetXml.replace(/<sheetProtection\b([^>]*)\/>/g,(m,a)=>{const clean=a.replace(/\sautoFilter="[^"]*"/g,'').replace(/\ssort="[^"]*"/g,'');return `<sheetProtection${clean} autoFilter="0" sort="0"/>`});tableId++;const relId=`rIdV19Table${tableId}`,parts=`<tableParts count="1"><tablePart r:id="${relId}"/></tableParts>`;if(/<extLst\b/.test(sheetXml))sheetXml=sheetXml.replace(/<extLst\b/,`${parts}<extLst`);else sheetXml=sheetXml.replace(/<\/worksheet>$/,`${parts}</worksheet>`);zip.file(sheetPath,sheetXml);let relXml=zip.file(relPath)?await zip.file(relPath).async('string'):'<?xml version="1.0" encoding="UTF-8" standalone="yes"?><Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships"></Relationships>';relXml=relXml.replace(/<\/Relationships>$/,`<Relationship Id="${relId}" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/table" Target="../tables/table${tableId}.xml"/></Relationships>`);zip.file(relPath,relXml);const columns=headers.map((h,i)=>`<tableColumn id="${i+1}" name="${v19XmlEscape(h)}"/>`).join(''),tableName=spec.name||`Tabella${spec.key.replace(/[^A-Za-z0-9]/g,'')}`,tableXml=`<?xml version="1.0" encoding="UTF-8" standalone="yes"?><table xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main" id="${tableId}" name="${tableName}" displayName="${tableName}" ref="${tableRef}" totalsRowShown="0" headerRowCount="1"><autoFilter ref="${tableRef}"/><tableColumns count="${headers.length}">${columns}</tableColumns><tableStyleInfo name="TableStyleMedium2" showFirstColumn="0" showLastColumn="0" showRowStripes="1" showColumnStripes="0"/></table>`;zip.file(`xl/tables/table${tableId}.xml`,tableXml);content=content.replace(/<\/Types>$/,`<Override PartName="/xl/tables/table${tableId}.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.table+xml"/></Types>`)}
  zip.file('[Content_Types].xml',content);return await zip.generateAsync({type:'uint8array',compression:'DEFLATE',compressionOptions:{level:6}})
}
