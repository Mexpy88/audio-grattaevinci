ffale<input id="rectFilterLocation" class="field" placeholder="Facoltativo"></label><label>Bancale<input id="rectFilterPallet" class="field" placeholder="Facoltativo"></label></div></div><input id="rectKey" type="hidden" value="${esc(this.rectifyDraft.selectedKey||'')}"></section><div id="rectifySelected">${selected?this.rectifySelectedMarkup(selected):'<div class="empty compact">Cerca e seleziona una giacenza per iniziare.</div>'}</div></div>`;
};
ui.rectifySelectedMarkup=function(r){
  const counted=Math.max(0,integer(this.rectifyDraft?.counted??r.quantity)),diff=counted-r.quantity,reason=this.rectifyDraft?.reason||'CONTEGGIO FISICO',note=this.rectifyDraft?.note||'';
  return `<section class="form-card v20-rect-selected"><div class="v20-selected-head"><div><span>GIACENZA SELEZIONATA</span><b>${esc(r.article)}${r.size?` · ${esc(r.size)}`:''}</b></div><div class="v20-current"><span>GIACENZA ATTUALE</span><strong>${r.quantity}</strong></div></div><div class="v20-meta"><span>${esc(r.state)}</span><span>Fila/Scaffale ${esc(r.location||'—')}</span><span>Bancale ${esc(r.pallet||'—')}</span></div><div class="v20-qty-panel"><span class="v20-label">NUOVA QUANTITÀ</span><div class="v20-stepper"><button type="button" data-action="rect-step-minus" aria-label="Diminuisci">−</button><input id="rectCounted" type="number" min="0" inputmode="numeric" value="${counted}"><button type="button" data-action="rect-step-plus" aria-label="Aumenta">＋</button></div><div id="rectMetricDiff" class="v20-delta ${diff<0?'negative':diff>0?'positive':'zero'}"><span>DIFFERENZA</span><b>${diff>0?'+':''}${diff}</b></div></div><label>Motivo rettifica<select id="rectReason" class="field"><option ${reason==='CONTEGGIO FISICO'?'selected':''}>CONTEGGIO FISICO</option><option ${reason==='ERRORE INSERIMENTO'?'selected':''}>ERRORE INSERIMENTO</option><option ${reason==='MERCE DANNEGGIATA'?'selected':''}>MERCE DANNEGGIATA</option><option ${reason==='ALTRO'?'selected':''}>ALTRO</option></select></label><label>Nota<input id="rectNote" class="field" value="${esc(note)}" placeholder="Facoltativa"></label><div class="v20-sticky-actions"><button type="button" class="workflow-cancel" data-action="workflow-back">ANNULLA</button><button type="button" class="primary v20-save-rect" data-action="rectify-save">SALVA RETTIFICA</button></div></section>`;
};
ui.renderRectifySelected=function(){const host=document.getElementById('rectifySelected');if(!host)return;const r=this.rectifyDraft?.selectedKey?this.domain.stock.findByKey(this.rectifyDraft.selectedKey):null;host.innerHTML=r?this.rectifySelectedMarkup(r):'<div class="empty compact">Cerca e seleziona una giacenza per iniziare.</div>'};
ui.rectifyFilters=function(){return{query:norm(document.getElementById('rectSearch')?.value),size:norm(document.getElementById('rectFilterSize')?.value),state:norm(document.getElementById('rectFilterState')?.value),location:positionKey(document.getElementById('rectFilterLocation')?.value),pallet:positionKey(document.getElementById('rectFilterPallet')?.value)}};
ui.renderRectifyResults=function(){
  const host=document.getElementById('rectifyResults');if(!host)return;const f=this.rectifyFilters(),selected=this.rectifyDraft?.selectedKey?this.domain.stock.findByKey(this.rectifyDraft.selectedKey):null,selectedLabel=selected?norm(`${selected.article}${selected.size?` · ${selected.size}`:''}`):'';
  if(selected&&f.query===selectedLabel){host.innerHTML='';host.classList.add('hidden');return}
  const active=!!(f.query||f.size||f.state||f.location||f.pallet);if(!active){host.innerHTML='<div class="v20-search-hint">Inizia a scrivere il codice articolo.</div>';host.classList.remove('hidden');return}
  const queryArticle=normalizeArticle(f.query.replace(/\s*·.*$/,'')),rows=this.domain.stock.positive().filter(r=>{const hay=norm(`${r.article} ${r.size}`);return(!f.query||hay.includes(f.query)||normalizeArticle(r.article).includes(queryArticle))&&(!f.size||norm(r.size)===f.size)&&(!f.state||norm(r.state)===f.state)&&positionMatches(r,f.location,f.pallet)}).slice(0,40);
  host.classList.remove('hidden');host.innerHTML=rows.length?rows.map(r=>`<button type="button" class="v20-rect-result" data-action="rectify-pick