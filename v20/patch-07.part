slice(prefix.length));if(Number.isFinite(n))max=Math.max(max,n)}return `${prefix}${String(max+1).padStart(3,'0')}`};
ui.loadCount=function(){const location=positionKey(document.getElementById('countLocation')?.value),pallet=positionKey(document.getElementById('countPallet')?.value);if(!location&&!pallet)throw new Error('Inserisci almeno Fila/Scaffale oppure Bancale.');if(this.countDraft&&!confirm('Ricaricare la posizione? Il conteggio in corso verrà sostituito senza modificare il magazzino.'))return;const rows=this.domain.stock.positive().filter(r=>positionMatches(r,location,pallet));this.countDraft={id:this.nextCountSessionId(),startedAt:nowIso(),location,pallet,rows:rows.map((r,i)=>({domId:`c${i}-${uid().slice(0,5)}`,key:bucketKey(r),source:r,partials:[],counted:null,verified:false,confirmed:false,confirmedAt:'',reopenedAt:'',editCount:0})),extras:[]};this.persistCountDraft();this.domain.audit.record('COUNT_SESSION_STARTED','COUNT_SESSION',this.countDraft.id,null,{location,pallet,lines:rows.length,startedAt:this.countDraft.startedAt});this.persistCountDraft();this.renderCountBody()};
const originalRenderCountBody=ui.renderCountBody.bind(ui);
ui.renderCountBody=function(){
  const host=document.getElementById('countBody');if(!host||!this.countDraft)return;const d=this.countDraft,total=d.rows.length+(d.extras||[]).length,done=d.rows.filter(r=>r.confirmed).length+(d.extras||[]).filter(r=>r.confirmed).length,differences=d.rows.filter(r=>r.confirmed&&Number(r.counted)!==Number(r.source.quantity)).length+(d.extras||[]).filter(r=>r.confirmed).length,pct=total?Math.round(done/total*100):0,expected=d.rows.map(r=>this.countRowMarkup(r)).join(''),extras=(d.extras||[]).map((r,i)=>this.countExtraMarkup(r,i)).join(''),scope=[d.location?`Fila/Scaffale ${d.location}`:'',d.pallet?`Bancale ${d.pallet}`:''].filter(Boolean).join(' · '),allDone=total>0&&done===total;
  host.innerHTML=`<section class="v20-count-header"><div><span>SESSIONE</span><b>${esc(d.id)}</b><small>${esc(scope)} · iniziata ${fmtDateTime(d.startedAt)}</small></div><div class="v20-count-progress"><strong>${done} / ${total}</strong><div><i style="width:${pct}%"></i></div></div></section><div class="v20-count-kpi"><div><b>${Math.max(0,total-done)}</b><span>Da contare</span></div><div><b>${done}</b><span>Confermati</span></div><div><b>${differences}</b><span>Differenze</span></div></div>${expected||'<div class="empty compact">Nessun articolo previsto con questi filtri esatti.</div>'}<section class="count-extra-section"><div class="section-label">MATERIALE NON PREVISTO</div>${extras}<button class="add-btn" data-action="count-extra-add">＋ MATERIALE TROVATO NON PREVISTO</button></section><div class="workflow-actions v20-count-actions"><button class="workflow-cancel" data-action="workflow-back">ESCI E RIPRENDI DOPO</button><button class="success count-finalize" data-action="count-finalize" ${allDone?'':'disabled'}>✓ CONCLUDI CONTEGGIO</button></div>`;
};
ui.countDifferences=function(){if(!this.countDraft)return[];const d=this.countDraft,rows=d.rows.map(r=>({kind:'EXPECTED',key:r.key,article:r.source.article,size:r.source.size,state:r.source.state,location:r.source.location,pallet:r.source.pallet,before:Number(r.source.quantity||0),after:Number(r.counted||0),delta:Number(r.counted||0)-Number(r.source.quantity||0)})).filter(r=>r.delta!==0),extras=(d.extras||[]).map(r=>{const location=positionKey(r.location||d.location),pallet=positionKey(r.pallet||d.pallet),match=this.domain.stock.positive().find(x=>normalizeArticle(x.article)===normalizeArticle(r.article)&&norm(x.size)===norm(r.size)&&norm(x.state)===norm(r.state)&&positionMatches(x,location,pallet)),before=Number(match?.quantity||0),after=Number(r.counted||0);return{kind:'EXTRA',key:match?bucketKey(match):'',article:r.article,size:r.size,state:r.state,location,pallet,before,after,delta:after-before}}).filter(r=>r.delta!==0);return[...rows,...extras]};
ui.ensureCountSummaryDialog=function(){let d=document.getElementById('v20CountSummary');if(d)return d;d=document.createElement('dialog');d.id='v20CountSummary';d.className='dialog v20-count-summary';d.innerHTML=`<div class="dialog-head"><h2>Riepilogo conteggio</h2><button type="butt