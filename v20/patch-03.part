    const tableDoc=v20ParseXml(await tf.async('string'),t.tablePath,errors),table=tableDoc.documentElement,ref=table.getAttribute('ref')||'',af=[...table.children].find(n=>n.localName==='autoFilter'),cols=[...tableDoc.getElementsByTagNameNS('*','tableColumn')];
    if(ref!==t.ref)errors.push(`${t.sheet}: ref tabella ${ref} diverso da ${t.ref}`);
    if(!af||af.getAttribute('ref')!==ref)errors.push(`${t.sheet}: AutoFilter tabella non sincronizzato`);
    if(v20RangeWidth(ref)!==cols.length||cols.length!==t.columns)errors.push(`${t.sheet}: numero colonne tabella incoerente`);
  }
  const checkWorkbookDoc=v20ParseXml(await zip.file(workbookPath).async('string'),workbookPath,errors);
  [...checkWorkbookDoc.getElementsByTagNameNS('*','definedName')].forEach(n=>{if(n.getAttribute('name')==='_xlnm._FilterDatabase'&&tableSheetIndexes.has(Number(n.getAttribute('localSheetId'))))errors.push(`_FilterDatabase residuo sul foglio ${n.getAttribute('localSheetId')}`)});
  for(const path of Object.keys(zip.files).filter(p=>/^xl\/worksheets\/sheet\d+\.xml$/.test(p))){const f=zip.file(path);if(!f)continue;const xml=await f.async('string');v20ParseXml(xml,path,errors);if(xml.includes('#REF!'))errors.push(`${path}: contiene #REF!`)}

  const uniqueErrors=[...new Set(errors)],validation={ok:uniqueErrors.length===0,build:V20_BUILD,baseCommit:V20_BASE_COMMIT,checkedAt:nowIso(),tables:created.map(t=>({sheet:t.sheet,ref:t.ref})),fixes:[...new Set(fixes)],errors:uniqueErrors};
  globalThis.__NOVA_V20_LAST_XLSX_VALIDATION