" data-key="${esc(bucketKey(r))}"><span><b>${esc(r.article)}${r.size?` · ${esc(r.size)}`:''}</b><small>${esc(r.state)} · Fila/Scaffale ${esc(r.location||'—')} · Bancale ${esc(r.pallet||'—')}</small></span><strong>${r.quantity}</strong></button>`).join(''):'<div class="empty compact">Nessuna giacenza corrisponde alla ricerca.</div>';
};
ui.rectPick=function(key){const r=this.domain.stock.findByKey(key);if(!r)throw new Error('Giacenza non disponibile.');const previousReason=this.rectifyDraft?.reason||'CONTEGGIO FISICO';this.rectifyDraft={selectedKey:bucketKey(r),counted:r.quantity,reason:previousReason,note:''};const search=document.getElementById('rectSearch');if(search)search.value=`${r.article}${r.size?` · ${r.size}`:''}`;const hidden=document.getElementById('rectKey');if(hidden)hidden.value=bucketKey(r);document.activeElement?.blur?.();const results=document.getElementById('rectifyResults');if(results){results.innerHTML='';results.classList.add('hidden')}this.renderRectifySelected()};
ui.rectDirect=function(value){if(!this.rectifyDraft)return;this.rectifyDraft.counted=Math.max(0,integer(value));this.updateRectMetrics()};
ui.updateRectMetrics=function(){const r=this.rectifyDraft?.selectedKey?this.domain.stock.findByKey(this.rectifyDraft.selectedKey):null;if(!r)return;const input=document.getElementById('rectCounted'),counted=Math.max(0,integer(input?.value??this.rectifyDraft.counted)),diff=counted-r.quantity,d=document.getElementById('rectMetricDiff');this.rectifyDraft.counted=counted;if(input&&String(input.value)!==String(counted))input.value=String(counted);if(d){d.className=`v20-delta ${diff<0?'negative':diff>0?'positive':'zero'}`;d.innerHTML=`<span>DIFFERENZA</span><b>${diff>0?'+':''}${diff}</b>`}};
ui.rectStep=function(delta){const input=document.getElementById('rectCounted');if(!input)return;input.value=String(Math.max(0,integer(input.value)+delta));this.rectDirect(input.value)};
ui.toggleRectFilters=function(){this.rectFiltersOpen=!this.rectFiltersOpen;document.getElementById('rectAdvanced')?.classList.toggle('hidden',!this.rectFiltersOpen);const b=document.querySelector('[data-action="rect-filter-toggle"]');if(b)b.innerHTML=`FILTRI AVANZATI <span>${this.rectFiltersOpen?'▴':'▾'}</span>`};
ui.saveRectify=async function(el){
  if(this.rectSaving)return;const key=this.rectifyDraft?.selectedKey||document.getElementById('rectKey')?.value;if(!key)throw new Error('Seleziona la giacenza da rettificare.');const counted=Math.max(0,integer(document.getElementById('rectCounted')?.value??this.rectifyDraft.counted)),reason=document.getElementById('rectReason')?.value||'CONTEGGIO FISICO',note=document.getElementById('rectNote')?.value||'',context=this.rectifyContext;
  this.rectSaving=true;const btn=el||document.querySelector('[data-action="rectify-save"]'),old=btn?.textContent;if(btn){btn.disabled=true;btn.textContent='SALVATAGGIO…'}
  try{this.domain.rectifications.setQuantity({currentKey:key,counted,reason,note,method:'RECTIFICATION_MANUAL'});this.rectifyDraft=null;this.rectifyContext=null;this.toast(`Rettifica registrata · ${counted} pezzi.`);if(context?.from==='stock'){this.router.back();const f=context.filters||{},set=(id,v)=>{const e=document.getElementById(id);if(e)e.value=v||''};set('stockQuery',f.query);set('stockState',f.state);set('stockLocation',f.location);set('stockPallet',f.pallet);this.renderStockResults();setTimeout(()=>globalThis.scrollTo?.({top:Number(f.scrollY)||0,behavior:'instant'}),0)}else this.router.replace('rectify',{key:''})}finally{this.rectSaving=false;if(btn?.isConnected){btn.disabled=false;btn.textContent=old||'SALVA RETTIFICA'}}
};

/* =========================================================
   3) CONTEGGIO ASSISTITO — session ID, KPI, summary/apply
   ========================================================= */
ui.nextCountSessionId=function(){const date=localDateInput(),prefix=`CNT-${date}-`;let max=0;for(const a of this.store.db.audits||[]){const id=String(a.entityId||'');if(id.startsWith(prefix)){const n=Number(id.slice(prefix.length));if(Number.isFinite(n))max=Math.max(max,n)}}const active=String(this.store.db.settings?.countDraft?.id||'');if(active.startsWith(prefix)){const n=Number(active.